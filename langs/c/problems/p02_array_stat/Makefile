# p02_array_stat 子 Makefile（AM 风格：判分核心见 ../../../core，本语言钩子见 ../../lang.mk）
#
# 用法：在本目录或根目录执行 make sim 判分。
# 模板即 array_stat.c：直接在其中 TODO 区填写实现，请勿改动文件名与函数签名（见 array_stat.h）；
# test/ 目录只放判分端 harness，不随题目发放；本 Makefile 请勿改动。
#
# 本题要求原地算法，额外禁止 qsort / malloc / calloc / realloc。

PID    := p02_array_stat
MODULE := array_stat
MODE   := func

STYLE_ARGS := --ban=qsort,malloc,calloc,realloc

LANG := ../..

include $(LANG)/lang.mk
