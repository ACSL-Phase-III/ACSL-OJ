# p04_str_ops 子 Makefile（AM 风格：判分核心见 ../../../core，本语言钩子见 ../../lang.mk）
#
# 用法：在本目录或根目录执行 make sim 判分。
# 模板即 str_ops.c：直接在其中 TODO 区填写实现，请勿改动文件名与函数签名（见 str_ops.h）；
# test/ 目录只放判分端 harness，不随题目发放；本 Makefile 请勿改动。
#
# 本题要求自己数长度、原地压缩，额外禁止 strlen / strrev / malloc 等。

PID    := p04_str_ops
MODULE := str_ops
MODE   := func

STYLE_ARGS := --ban=strlen,strnlen,malloc,calloc,realloc,strdup

LANG := ../..

include $(LANG)/lang.mk
