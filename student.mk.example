# student.mk.example —— 学员信息模板
#
# 这是**仓库里跟踪的模板**。你自己那份是 student.mk，平台会在第一次跑 make 时
# 由本文件自动复制生成（见 core/trace.mk），改它不会被 git pull 冲掉，
# 也不会在每周日取新题时和老师的仓库撞。
#
# 本文件被顶层 Makefile 与各语言模块共同 include，所以填一次即对所有语言生效。
# 填好后在平台根目录执行 make init 创建 trace 分支。

# ===================== 学员信息（请先填写，再 make init）=====================
STUID := 000000
NAME  := 未填写
# ===================== 云端 trace 设置 =======================================
# TRACE_REMOTE：推送 trace 分支的远端名
# AUTOPUSH    ：1=每次判分后自动同步云端；0=只在本地留痕（可随后 make trace-push）
TRACE_REMOTE := origin
AUTOPUSH     := 1
# =============================================================================
